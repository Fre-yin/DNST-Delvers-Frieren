<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DungeonSettlersDelvers.Frieren</AssemblyName>
    <RootNamespace>FrierenPortrait</RootNamespace>
  </PropertyGroup>
  <Import Project="../GameReferences.props" />
  <ItemGroup>
    <ProjectReference Include="$(DelversCoreRoot)/Core/DungeonSettlersDelvers.Core.csproj" />
    <!-- Lets the private in-game self-test reach internal members; no runtime cost. -->
    <InternalsVisibleTo Include="DungeonSettlersDelvers.SelfTest" />
    <Compile Include="../ProjectRules.cs" Link="ProjectRules.cs" />
    <!-- Zoltraak's own sounds: AudioClip, AudioSource and the game's mixer group. The interop's
         UnityEngine.dll repeats ManagedSpanWrapper, so the core module gets an alias as well. -->
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(GameInteropDir)/UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Update="UnityEngine.CoreModule" Aliases="global,UnityCore" />
    <Content Include="Assets/*.png" Link="Frieren/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Sounds/*.wav" Link="Frieren/Sounds/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
